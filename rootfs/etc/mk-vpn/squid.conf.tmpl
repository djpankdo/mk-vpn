
# Sem Safe_ports nem SSL_ports: as ACLs padrao do Squid so deixam o CONNECT
# chegar na 443, e recusam HTTP simples abaixo da 1025. Isso derruba aplicacao
# web servida em porta fora do comum, que e justamente o que este proxy precisa
# alcancar. Quem pode falar com o proxy e decidido no firewall do MikroTik, e
# nao aqui dentro.
#
# Sem essas ACLs, a de metodo CONNECT tambem deixou de existir: ela so servia
# para a regra que limitava o CONNECT a 443.

# O cache manager continua so em localhost: ele expoe estatisticas internas do
# proprio Squid, nao e destino de navegacao, e liberar isso nao ajuda ninguem.
http_access allow localhost manager
http_access deny manager

# Sem cache em disco: o storage do MikroTik nao e lugar para isso, e um cache
# de conteudo corporativo dentro do roteador nao interessa a ninguem.
cache deny all
cache_mem 8 MB

# Logs no stdout/stderr, que e o que o "/container/log" do RouterOS mostra.
access_log stdio:/dev/stdout squid
cache_log /dev/stdout
cache_store_log none
logfile_rotate 0

pid_filename /run/squid.pid
shutdown_lifetime 3 seconds
forwarded_for delete
via off
httpd_suppress_version_string on
